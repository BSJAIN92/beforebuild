# EXPLICIT local demonstration. Set to false before inviting beta users.
# Demo data stays in this browser; no live AI, authentication or research is used.
NEXT_PUBLIC_DEMO_MODE=true

# Vercel / Next.js (public identifiers, not secrets)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Convex production deploy key: set on Vercel, NOT in browser code.
CONVEX_DEPLOY_KEY=

# Set the following in the CONVEX DASHBOARD, not just on Vercel:
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# ADMIN_EMAILS=you@example.com
# BETA_ALLOWLIST=first@example.com,second@example.com
# OPENAI_API_KEY=...
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_INTERVIEW_MODEL=gpt-4.1-mini
# AI_RESEARCH_MODEL=gpt-4.1
# AI_DEEP_RESEARCH_MODEL=o3-deep-research
# AI_DEEP_SEARCH_TOOL=web_search_preview
# Per-user limits reset at 00:00 UTC. Adjust these when plan prices or allowances change.
# AI_BASIC_DAILY_TURNS=10
# AI_INTERMEDIATE_DAILY_TURNS=15
# AI_INTERMEDIATE_DAILY_RESEARCH=1
# AI_ADVANCED_DAILY_TURNS=22
# AI_ADVANCED_DAILY_RESEARCH=1
# AI_MAX_IDEAS=30
# BILLING_ENABLED=false
# PRICE_CURRENCY=USD
# INTERMEDIATE_PRICE_CENTS=0
# ADVANCED_PRICE_CENTS=0
